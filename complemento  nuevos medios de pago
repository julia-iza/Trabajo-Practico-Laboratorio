    # Aplicación de las reglas de limpieza en Capa Silver
    df_silver = df_bronze_sube.copy()
    df_silver["cantidad_int"] = df_silver["cantidad"].astype(str).str.strip().astype(np.int64)
    df_silver["cant_trj_int"] = df_silver["cant_trj"].astype(str).str.strip().astype(np.int64)

    # Regla de imputación geográfica en Subte para evitar pérdida por INNER JOIN
    mask_subte = (df_silver["tipo_transporte"] == "subte") & (df_silver["amba"] == "SI")
    df_silver.loc[mask_subte, ["jurisdiccion", "provincia", "municipio"]] = ["CABA", "CIUDAD AUTONOMA DE BUENOS AIRES", "CABA"]
    df_silver["region_indec"] = np.where(df_silver["amba"] == "SI", "GBA", "Pampeana")
    df_silver["segmento_nominacion"] = np.where(df_silver["genero"].isin(["F", "M"]), "SUBE Registrada", "SUBE Sin Registrar (Nulo)")

    # Separación de modos vs fila 'total' de usuarios únicos
    df_modos_silver = df_silver.loc[df_silver["tipo_transporte"] != "total"].copy()
    print("\n[TABLA 2.1] Muestra de Lote SUBE Procesado en Capa Silver (Imputación Subte y Exclusión de 'total'):")
    print(df_modos_silver[["dia_transporte", "tipo_transporte", "jurisdiccion", "region_indec", "cantidad_int", "segmento_nominacion", "dato_preliminar"]].to_string(index=False))

    # 2. Motor de Deflación Dual Laspeyres (Cociente de Números Índice Base Dic 2016 = 100)
    ipc_jul25_ng, ipc_jul26_ng, ipc_ago26_ng = 9020.4500, 12071.5496, 12276.7660
    ipc_jul25_tp, ipc_jul26_tp = 8650.0000, 13435.4500 # Índice apertura Transporte Público GBA
    monto_sube_jul25, monto_sube_jul26 = 147173.6, 193680.5 # +31.6% nominal i.a.

    var_real_ipc_ng = (((monto_sube_jul26 / ipc_jul26_ng) / (monto_sube_jul25 / ipc_jul25_ng)) - 1) * 100
    var_real_ipc_tp = (((monto_sube_jul26 / ipc_jul26_tp) / (monto_sube_jul25 / ipc_jul25_tp)) - 1) * 100
    print(f"\n[AUDITORÍA DEFLACIÓN LASPEYRES SUBE JUL-2026]:")
    print(f"  • Variación Nominal Recaudación SUBE: +31,60% i.a.")
    print(f"  • Variación Real Deflactada con IPC Nivel General (BCRA): {var_real_ipc_ng:.2f}% i.a.")
    print(f"  • Variación Real Deflactada con IPC Transporte Público:   {var_real_ipc_tp:.2f}% i.a. (Alineada con -22,0% en viajes)")

